  alt       String?
  link      String?
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("home_sliders")
}

// "چرا ما" — icon + claim.
model HomeTrustBox {
