# PostgreSQL connection (Prisma format)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/lidoma?schema=public"

# App
PORT=4000
NODE_ENV=development
APP_URL="http://localhost:4000"
CORS_ORIGINS="http://localhost:3000"

# Auth
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# OTP (SMS provider) - fill in with real provider (e.g. Kavenegar, Melipayamak, ...)
SMS_PROVIDER_API_KEY=""
SMS_PROVIDER_SENDER=""
OTP_TTL_SECONDS=120
OTP_CODE_LENGTH=5

# Admin bootstrap (used by prisma/seed.ts to create the first admin user)
ADMIN_BOOTSTRAP_PHONE="09120000000"
ADMIN_BOOTSTRAP_PASSWORD="ChangeMe123!"

# Object storage (Liara Object Storage, S3-compatible). Leave unset to fall
# back to local disk storage under ./uploads (fine for dev, not production).
LIARA_ENDPOINT=""
LIARA_BUCKET=""
LIARA_ACCESS_KEY=""
LIARA_SECRET_KEY=""

# Shared cache (Redis). Leave unset to run without one — every cache call
# becomes a no-op and reads go straight to the database. On Liara this is the
# private-network URI from the Redis panel, which is not reachable from a
# laptop, so it stays empty in local development.
REDIS_URL=""
