// LidomaTrip backend — Phase 1 schema
// Scope: auth, users, residences/rooms, amenities/rules, calendar & pricing,
// search support, reservations, favourites, host bank info, admin.
// Phase 2 (not modeled yet): wallet transactions, host payouts/settlements,
// order-scoped chat, reviews, complaints/contact-form, support chat, vouchers.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum UserRole {
  USER
  ADMIN
}

enum VerificationStatus {
  NOT_CONFIRMED
  CHECKING
  CONFIRMED
}

// "نوع ملک" — the residence's own category, independent of the city
// taxonomy. Mirrors legacy Odoo product_template.x_display_type
// (suit | boomgardi | hotel); Odoo's rare "both" collapses to SUIT, which
// is how the old site's tag domains already treated it.
enum ResidenceType {
  BOOMGARDI // eco-lodge / rural stay
  SUIT // villa / apartment / suite
  HOTEL // hotel & hotel-apartment
}

enum ResidenceState {
  DRAFT // wizard in progress, not submitted
  PENDING // submitted, awaiting review
  PUBLISHED
  REJECTED
  DEACTIVATED
  DELETED
}

enum BedRoomType {
  NONE
  SHARED
  DEDICATED
}

enum DiscountType {
  PERCENTAGE
  FIXED_PRICE
}

enum AmenityFieldType {
  TEXT
  DROPDOWN
  SWITCH
  CHECKBOX
}

enum ReservationState {
  HOST_APPROVAL
  SECOND_PAYMENT
  DONE
  CANCEL
  EXPIRED
}

enum ReservationCancelledBy {
  HOST_CANCELLED
  LIDOMA_CANCELLED
  GUEST_CANCELLED
}

enum OtpPurpose {
  LOGIN
  SIGNUP
  RESET_PASSWORD
}

// The legacy Odoo product_public_category tree had six kinds of place
// (x_category_type). Only city/province were ever migrated; the rest are the
// breadcrumb levels the marketing team actually curated.
enum LocationType {
  COUNTRY
  PROVINCE
  CITY
  REGION // marketing region: شمال، اطراف تهران، … — spans provinces/cities
  VILLAGE
  NEIGHBORHOOD
}

// ---------- Geo ----------

// Legacy Odoo SEO URLs (e.g. "/tags/villa/اجاره-ویلا-در-آبادان") -> their
// 301 target on the new site (e.g. "/search/abadan?villa=1"). Populated from
// the legacy `tag_url` table by scripts/migrate-odoo-tag-urls.ts; consumed by
// the frontend's /tags/[...slug] catch-all page so old indexed URLs keep
// their SEO value.
model LegacyRedirect {
  id     Int    @id @default(autoincrement())
  path   String @unique
  target String

  @@map("legacy_redirects")
}

// Legacy Odoo image URLs ("/web/image/<model>/<odoo id>/image/<seo-name>.jpg",
// served from cdn.lidomatrip.com) -> the migrated object-storage URL. These
// are Google-Images-indexed; the frontend's /web/image catch-all 301s them.
// Populated by scripts/migrate-odoo-image-urls.ts.
model LegacyImageRedirect {
  id     Int    @id @default(autoincrement())
  model  String // "product.image" (gallery) | "product.template" (main image)
  odooId Int    @map("odoo_id")
  url    String

  @@unique([model, odooId])
  @@map("legacy_image_redirects")
}

// One self-referencing tree for every kind of place, mirroring legacy Odoo's
// product_public_category. This table IS the old `cities` table renamed, so
// every city id (and therefore every residences.location_id) survives the
// migration untouched — /search/<titleEn> keeps resolving to the same row.
// Provinces were merged in as PROVINCE rows with fresh ids.
model Location {
  id      Int          @id @default(autoincrement())
  // Legacy product_public_category.id. The original migration never stored
  // this and re-matched places by name, which is why per-type SEO and the
  // 9,969 tag_url pages could not be attached. Everything keys off it now.
  odooId  Int?         @unique @map("odoo_id")
  type    LocationType @default(CITY)
  name    String
  titleEn String?      @map("title_en")

  imageUrl  String? @map("image_url")
  bannerUrl String? @map("banner_url")

  // Breadcrumb chain: کشور › استان › شهر › محله
  parentId Int?       @map("parent_id")
  parent   Location?  @relation("LocationTree", fields: [parentId], references: [id])
  children Location[] @relation("LocationTree")

  // "شهرهای زیرمجموعه" — deliberately separate from the breadcrumb tree. A
  // search for this location also returns listings of every included one
  // (شمال -> مازندران/گیلان/گلستان). Replaces the hardcoded REGION_ALIASES.
  includes   LocationInclude[] @relation("IncludeParent")
  includedIn LocationInclude[] @relation("IncludeChild")

  // Odoo x_canonical_category — SEO consolidation onto another place
  // (e.g. آذربایجان غربی -> ارومیه).
  canonicalId  Int?       @map("canonical_id")
  canonical    Location?  @relation("LocationCanonical", fields: [canonicalId], references: [id])
  canonicalFor Location[] @relation("LocationCanonical")

  latitude  Float?
  longitude Float?

  isActive     Boolean @default(true) @map("is_active")
  isPublished  Boolean @default(true) @map("is_published") // website_published
  isPrimary    Boolean @default(false) @map("is_primary") // x_asli
  sortOrder    Int     @default(0) @map("sort_order")
  popularIndex Int?    @map("popular_index")
  shomalIndex  Int?    @map("shomal_index")
  keywords     String? // x_tags — free-text keyword list

  seo             LocationSeo[]
  tagPages        TagPage[]
  residences      Residence[]
  extraResidences ResidenceLocation[]
  peakDays        PeakDayLocation[]
  users           User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([parentId])
  @@index([titleEn])
  @@map("locations")
}

// Membership in a parent location's result set, independent of the breadcrumb
// tree. `parent` is the place being searched; `child` contributes its listings.
model LocationInclude {
  id       Int      @id @default(autoincrement())
  parentId Int      @map("parent_id")
  parent   Location @relation("IncludeParent", fields: [parentId], references: [id], onDelete: Cascade)
  childId  Int      @map("child_id")
  child    Location @relation("IncludeChild", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
  @@index([childId])
  @@map("location_includes")
}

// Odoo kept three parallel SEO sets per place: the default one plus dedicated
// بوم‌گردی and هتل variants (x_boomgardi_*, x_hotel_*), each with its own meta,
// guide text and support phone. `residenceType = null` is the default set.
model LocationSeo {
  id            Int            @id @default(autoincrement())
  locationId    Int            @map("location_id")
  location      Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  residenceType ResidenceType? @map("residence_type")

  pageTitle       String? @map("page_title")
  metaTitle       String? @map("meta_title")
  metaDescription String? @map("meta_description")
  metaKeywords    String? @map("meta_keywords")
  contentTitle    String? @map("content_title")
  contentHtml     String? @map("content_html")

  phone          String?
  showPhone      Boolean @default(false) @map("show_phone")
  showPhoneFrom  Int?    @map("show_phone_from")
  showPhoneTo    Int?    @map("show_phone_to")
  showInHomepage Boolean @default(false) @map("show_in_homepage")
  homepageIndex  Int?    @map("homepage_index")

  @@unique([locationId, residenceType])
  @@map("location_seo")
}

// "روزهای پیک" — global date ranges that switch pricing to the peak rate
// (legacy Odoo x_peak_days). Managed in admin settings; ranges apply to every
// residence unless scoped to specific locations.
model PeakDay {
  id        Int               @id @default(autoincrement())
  name      String
  startDate DateTime          @map("start_date")
  endDate   DateTime          @map("end_date")
  isActive  Boolean           @default(true) @map("is_active")
  locations PeakDayLocation[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([startDate, endDate])
  @@map("peak_days")
}

// Optional location scoping — no rows means the peak range is nationwide.
model PeakDayLocation {
  id         Int      @id @default(autoincrement())
  peakDayId  Int      @map("peak_day_id")
  peakDay    PeakDay  @relation(fields: [peakDayId], references: [id], onDelete: Cascade)
  locationId Int      @map("location_id")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([peakDayId, locationId])
  @@map("peak_day_locations")
}

// ---------- Users ----------

// Admin-issued warning ("کارت زرد") with a required reason — shown on the
// admin user-detail page.
model UserYellowCard {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation("UserYellowCards", fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  adminId   Int?     @map("admin_id")
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("user_yellow_cards")
}

model User {
  id                 Int                @id @default(autoincrement())
  phone              String             @unique
  passwordHash       String?            @map("password_hash")
  name               String?
  email              String?
  nationalCode       String?            @map("national_code")
  address            String?
  locationId         Int?               @map("location_id")
  location           Location?          @relation(fields: [locationId], references: [id])
  zip                String?
  fax                String?
  job                String?
  education          String?
  birthDay           Int?               @map("birth_day")
  birthMonth         Int?               @map("birth_month")
  birthYear          Int?               @map("birth_year")
  emergencyPhone     String?            @map("emergency_phone")
  contactPhone       String?            @map("contact_phone")
  avatarUrl          String?            @map("avatar_url")
  nationalCardUrl    String?            @map("national_card_url")
  description        String?
  verificationStatus VerificationStatus @default(NOT_CONFIRMED) @map("verification_status")
  isHost             Boolean            @default(false) @map("is_host")
  role               UserRole           @default(USER)
  // admin panel: deactivated users can't log in / operate
  isActive           Boolean            @default(true) @map("is_active")
  // admin panel: "میزبان ویژه" highlight flag
  isSpecialHost      Boolean            @default(false) @map("is_special_host")

  bankAccount         BankAccount?
  yellowCards         UserYellowCard[] @relation("UserYellowCards")
  residences          Residence[]      @relation("HostResidences")
  reservationsAsGuest Reservation[]    @relation("GuestReservations")
  reservationsAsHost  Reservation[]    @relation("HostReservations")
  favourites          Favourite[]
  otpCodes            OtpCode[]
  refreshTokens       RefreshToken[]
  reviews             Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId])
  @@map("users")
}

model BankAccount {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardNumber     String?  @map("card_number")
  cardOwnerName  String?  @map("card_owner_name")
  shabaNumber    String?  @map("shaba_number")
  shabaOwnerName String?  @map("shaba_owner_name")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("bank_accounts")
}

model OtpCode {
  id         Int        @id @default(autoincrement())
  phone      String
  userId     Int?       @map("user_id")
  user       User?      @relation(fields: [userId], references: [id])
  codeHash   String     @map("code_hash")
  purpose    OtpPurpose
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at")
  consumedAt DateTime?  @map("consumed_at")
  createdAt  DateTime   @default(now())

  @@index([phone, purpose])
  @@map("otp_codes")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------- Amenities & Rules (catalogs) ----------

model Amenity {
  id         Int                @id @default(autoincrement())
  // stable English key from Odoo's product_attribute.x_title_en (pool,
  // jacuzzi, parking, type, area, ...) — search tag filters match on this
  key        String?            @unique
  category   String?
  name       String
  iconUrl    String?            @map("icon_url")
  features   AmenityFeature[]
  residences ResidenceAmenity[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@map("amenities")
}

model AmenityFeature {
  id          Int              @id @default(autoincrement())
  amenityId   Int              @map("amenity_id")
  amenity     Amenity          @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  fieldType   AmenityFieldType @map("field_type")
  name        String
  placeholder String?
  values      String? // comma-separated option list, e.g. "دارد, ندارد"
  inFilter    Boolean          @default(false) @map("in_filter")

  @@index([amenityId])
  @@map("amenity_features")
}

model Rule {
  id         Int             @id @default(autoincrement())
  // stable English key from Odoo's product_attribute.x_title_en
  // (smoking, pets, events, 24h, singles, id-required, cancellation)
  key        String?         @unique
  category   String?
  name       String
  iconUrl    String?         @map("icon_url")
  residences ResidenceRule[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@map("rules")
}

// ---------- Residences ----------

model Residence {
  id                Int            @id @default(autoincrement())
  reference         String         @unique
  hostId            Int            @map("host_id")
  host              User           @relation("HostResidences", fields: [hostId], references: [id])
  type              ResidenceType
  state             ResidenceState @default(DRAFT)
  step              Int?
  completionPercent Int?           @map("completion_percent")
  published         Boolean        @default(false)

  name        String
  name2       String?
  description String?
  region      String? // coarse marketing region picked in the wizard (e.g. "شمال", "تهران و اطراف")
  rentType    String? @map("rent_type") // whole-place vs per-room etc, wizard step 3

  locationId        Int?      @map("location_id")
  location          Location? @relation(fields: [locationId], references: [id])
  neighborhood      String?
  address           String?
  // "آدرس در فاکتور" — the full postal address printed on invoices; the
  // public page shows the coarser `address` instead.
  invoiceAddress    String?   @map("invoice_address")
  // "نام پیشنهادی میزبان" — what the host proposed; `name` is what actually
  // renders publicly after admin review.
  hostSuggestedName String?   @map("host_suggested_name")
  latitude          Float?
  longitude         Float?
  floor             String?
  foundationArea    Float?    @map("foundation_area")
  totalArea         Float?    @map("total_area")

  capacity    Int?
  maxCapacity Int? @map("max_capacity")

  checkinFrom       String? @map("checkin_from")
  checkinTo         String? @map("checkin_to")
  checkout          String?
  minReservableDays Int?    @map("min_reservable_days")
  rulesDesc         String? @map("rules_desc") // free-text "additional rules", wizard step 12

  cancelCommission       Float?  @map("cancel_commission")
  reserveCommission      Float?  @map("reserve_commission")
  cancellationPolicy     String? @map("cancellation_policy") // preset key or "custom", wizard step 13
  cancellationPolicyDesc String? @map("cancellation_policy_desc")
  fullReturnTime         Int?    @map("full_return_time")
  beforeStartTime        Int?    @map("before_start_time")
  hostShareTotalAmount   Float?  @map("host_share_total_amount")
  hostSharePastNights    Float?  @map("host_share_past_nights")
  hostShareFutureNights  Float?  @map("host_share_future_nights")

  otherAmenities String? @map("other_amenities") // free-text "other" amenities, wizard step 6

  hostNationalCardUrl  String? @map("host_national_card_url")
  documentUrl          String? @map("document_url") // property ownership proof
  ownerNationalCardUrl String? @map("owner_national_card_url") // only when host isn't the owner

  // General pricing (per-residence baseline; rooms may override)
  weekPrice            Float? @map("week_price")
  weekendPrice         Float? @map("weekend_price")
  peakPrice            Float? @map("peak_price")
  extraPrice           Float? @map("extra_price")
  extraGuestsPrice     Float? @map("extra_guests_price")
  // "نرخ نفر اضافه ( ایام پیک )" — the per-extra-guest rate during peak days
  extraGuestsPeakPrice Float? @map("extra_guests_peak_price")
  weeklyDiscount       Float? @map("weekly_discount")
  monthlyDiscount      Float? @map("monthly_discount")

  videoUrl          String? @map("video_url")
  // Host's free-text rules (legacy Odoo product_template.x_extra_rules) —
  // {"desc": "...", "<rule attr id>": ""|{"desc": "..."}}; the frontend's
  // ResRules reads its stringified form.
  extraRules        Json?   @map("extra_rules")
  // Boomgardi-only free-text feature names (legacy x_features, "#%"-joined)
  // — shown as "امکانات بوم گردی" on the detail page.
  boomgardiFeatures Json?   @map("boomgardi_features")
  isFast            Boolean @default(false) @map("is_fast") // instant-book default
  isFull            Boolean @default(false) @map("is_full")
  isOffer           Boolean @default(false) @map("is_offer")
  salesCount        Int     @default(0) @map("sales_count")

  averageRating Float @default(0) @map("average_rating")
  reviewsCount  Int   @default(0) @map("reviews_count")

  // "اهمیت اقامتگاه" — manual ranking weight set by the ops team (legacy
  // Odoo product_template.x_sequence, values up to 2e9). Higher = shown
  // earlier in the default ("پیشنهاد لیدوما") search ordering.
  importance Int @default(0)

  images         ResidenceImage[]
  distances      ResidenceDistance[]
  extraLocations ResidenceLocation[]
  rooms          Room[]
  amenities      ResidenceAmenity[]
  rules          ResidenceRule[]
  calendarDays   CalendarDay[]
  reservations   Reservation[]
  favouritedBy   Favourite[]
  reviews        Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostId])
  @@index([locationId])
  @@index([state, published])
  @@map("residences")
}

// "فاصله تا جاذبه‌های گردشگری" — distance/ETA from a residence to a nearby
// landmark (legacy Odoo x_residence_place_distance + x_attractions).
model ResidenceDistance {
  id          Int       @id @default(autoincrement())
  residenceId Int       @map("residence_id")
  residence   Residence @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  placeName   String    @map("place_name")
  distance    String? // free text, e.g. "۷ کیلومتر"
  eta         String? // free text, e.g. "۱ ساعت و ۲۹ دقیقه"
  sortOrder   Int       @default(0) @map("sort_order")

  @@index([residenceId])
  @@map("residence_distances")
}

// "دیگر شهرهای اقامتگاه" — extra locations a residence is listed under, beyond
// its primary `locationId` (legacy product_public_category_product_template_rel).
model ResidenceLocation {
  id          Int       @id @default(autoincrement())
  residenceId Int       @map("residence_id")
  residence   Residence @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  locationId  Int       @map("location_id")
  location    Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([residenceId, locationId])
  @@index([locationId])
  @@map("residence_locations")
}

model ResidenceImage {
  id          Int       @id @default(autoincrement())
  residenceId Int       @map("residence_id")
  residence   Residence @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  url         String
  title       String?
  sortOrder   Int       @default(0) @map("sort_order")
  isMain      Boolean   @default(false) @map("is_main")
  createdAt   DateTime  @default(now())

  @@index([residenceId])
  @@map("residence_images")
}

model Room {
  id          Int       @id @default(autoincrement())
  residenceId Int       @map("residence_id")
  residence   Residence @relation(fields: [residenceId], references: [id], onDelete: Cascade)

  name        String
  description String?
  image       String?

  capacity       Int?
  maxCapacity    Int? @map("max_capacity")
  singleBed      Int  @default(0) @map("single_bed")
  doubleBed      Int  @default(0) @map("double_bed")
  traditionalBed Int  @default(0) @map("traditional_bed")
  extraBeds      Int  @default(0) @map("extra_beds")

  weekPrice       Float? @map("week_price")
  weekendPrice    Float? @map("weekend_price")
  peakPrice       Float? @map("peak_price")
  extraPrice      Float? @map("extra_price")
  extraPeakPrice  Float? @map("extra_peak_price")
  weeklyDiscount  Float? @map("weekly_discount")
  monthlyDiscount Float? @map("monthly_discount")

  coolingSystem    Boolean?     @map("cooling_system")
  heatingSystem    Boolean?     @map("heating_system")
  refrigerator     BedRoomType?
  wc               BedRoomType?
  separateBathroom Boolean?     @map("separate_bathroom")
  freeBreakfast    Boolean?     @map("free_breakfast")

  isFast     Boolean @default(false) @map("is_fast")
  salesCount Int     @default(0) @map("sales_count")

  calendarDays     CalendarDay[]
  reservationRooms ReservationRoom[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([residenceId])
  @@map("rooms")
}

model ResidenceAmenity {
  id            Int       @id @default(autoincrement())
  residenceId   Int       @map("residence_id")
  residence     Residence @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  amenityId     Int       @map("amenity_id")
  amenity       Amenity   @relation(fields: [amenityId], references: [id])
  extraFeatures Json?     @map("extra_features") // selected feature values keyed by feature name

  @@unique([residenceId, amenityId])
  @@index([amenityId])
  @@map("residence_amenities")
}

model ResidenceRule {
  id          Int       @id @default(autoincrement())
  residenceId Int       @map("residence_id")
  residence   Residence @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  ruleId      Int       @map("rule_id")
  rule        Rule      @relation(fields: [ruleId], references: [id])
  value       Json? // override / description text for this residence

  @@unique([residenceId, ruleId])
  @@index([ruleId])
  @@map("residence_rules")
}

// ---------- Calendar & pricing overrides ----------

model CalendarDay {
  id             Int           @id @default(autoincrement())
  residenceId    Int           @map("residence_id")
  residence      Residence     @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  roomId         Int?          @map("room_id") // null = applies at residence level
  room           Room?         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  date           DateTime      @db.Date
  isBlocked      Boolean       @default(false) @map("is_blocked") // reserved / manually filled
  isFast         Boolean?      @map("is_fast") // instant-book override for this date
  isPeak         Boolean       @default(false) @map("is_peak")
  specialPrice   Float?        @map("special_price")
  discountAmount Float?        @map("discount_amount")
  discountType   DiscountType? @map("discount_type")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NOTE: Postgres does not enforce uniqueness across NULLs, so this
  // constraint does not fully prevent duplicate residence-level
  // (roomId = null) rows under concurrent writes. Fine for single-host
  // sequential updates (the only write path today); if concurrent bulk
  // calendar edits become common, replace with a sentinel roomId or a
  // partial unique index (`WHERE room_id IS NULL`) via a raw migration.
  @@unique([residenceId, roomId, date])
  @@index([residenceId, date])
  @@map("calendar_days")
}

// ---------- Reservations ----------

model Reservation {
  id        Int    @id @default(autoincrement())
  reference String @unique

  residenceId Int       @map("residence_id")
  residence   Residence @relation(fields: [residenceId], references: [id])
  guestId     Int       @map("guest_id")
  guest       User      @relation("GuestReservations", fields: [guestId], references: [id])
  hostId      Int       @map("host_id")
  host        User      @relation("HostReservations", fields: [hostId], references: [id])

  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime  @map("end_date") @db.Date
  expiryDate DateTime? @map("expiry_date") // payment/approval deadline
  daysCount  Int       @map("days_count")

  guestsCount      Int @map("guests_count")
  extraGuestsCount Int @default(0) @map("extra_guests_count")

  state ReservationState @default(HOST_APPROVAL)

  cancelledBy  ReservationCancelledBy? @map("cancelled_by")
  cancelReason String?                 @map("cancel_reason")
  cancelDesc   String?                 @map("cancel_desc")

  totalAmount     Float  @map("total_amount")
  paidAmount      Float  @default(0) @map("paid_amount")
  remainingAmount Float  @default(0) @map("remaining_amount")
  hostShare       Float? @map("host_share")
  websiteShare    Float? @map("website_share")

  voucherCode String? @map("voucher_code")

  guestNameOverride  String? @map("guest_name_override") // booking-for-someone-else
  guestPhoneOverride String? @map("guest_phone_override")

  rooms  ReservationRoom[]
  review Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([residenceId])
  @@index([guestId])
  @@index([hostId])
  @@index([state])
  @@map("reservations")
}

model ReservationRoom {
  id            Int         @id @default(autoincrement())
  reservationId Int         @map("reservation_id")
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  roomId        Int         @map("room_id")
  room          Room        @relation(fields: [roomId], references: [id])

  @@unique([reservationId, roomId])
  @@map("reservation_rooms")
}

// ---------- Reviews ----------
// One review per completed reservation (guest side). The single displayed
// "rating" is an average of 6 sub-scores — matches the shape the frontend's
// review UI (built years before this backend) already expects, so it needs
// no changes: `front/components/SubmitReviewForMyTrip`,
// `front/components/ObserveResidenceDetails/.../ResReviews`,
// `front/components/Host/GuestsReviews`.

model Review {
  id            Int         @id @default(autoincrement())
  reservationId Int         @unique @map("reservation_id")
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  residenceId   Int         @map("residence_id")
  residence     Residence   @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  guestId       Int         @map("guest_id")
  guest         User        @relation(fields: [guestId], references: [id])

  cleaning      Int
  location      Int
  quality       Int
  integrity     Int
  greeting      Int
  delivery      Int
  // Stored (not just computed on read) so residence-level average/count
  // aggregation stays a cheap read — recomputed whenever a review is
  // created for that residence.
  averageRating Float @map("average_rating")

  comment    String
  hostAnswer String? @map("host_answer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([residenceId])
  @@index([guestId])
  @@map("reviews")
}

// ---------- Favourites ----------

model Favourite {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  residenceId Int       @map("residence_id")
  residence   Residence @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, residenceId])
  @@map("favourites")
}

// ---------- SEO tags ----------
// A tag is a saved combination of residence attributes that gets its own
// indexed landing page (استخردار، جنگلی، کلبه چوبی، …). Tag pages exist
// instead of a generic filter URL because each one carries its own curated
// SEO identity and ranks for its own query.
//
// These used to be four disagreeing hardcoded tables in the service layer;
// the filter itself now lives in the database, imported verbatim from legacy
// Odoo's website_tags.x_domain.

model SeoTag {
  id            Int            @id @default(autoincrement())
  odooId        Int?           @unique @map("odoo_id")
  // Query-param key (/search/<city>?<key>=1). IMMUTABLE — ~10k rows in
  // legacy_redirects already point at these exact keys.
  key           String         @unique
  // Long display name, e.g. "اجاره ویلا و سوئیت استخردار" (Odoo x_name).
  name          String
  // Short chip label used in breadcrumbs/filters, e.g. "استخردار".
  shortLabel    String?        @map("short_label")
  // Internal note describing the combination (Odoo x_desc).
  description   String?
  // Scopes the tag to one residence type (Odoo x_type: suit | boomgardi).
  residenceType ResidenceType? @map("residence_type")

  // Price-band tags (لوکس / ارزان) — Odoo x_price_range, previously a
  // hardcoded 500,000 threshold in the search service.
  priceMin    Float?  @map("price_min")
  priceMax    Float?  @map("price_max")
  // "رزرو آنی" — matches Residence.isFast rather than an attribute.
  matchIsFast Boolean @default(false) @map("match_is_fast")

  contentTitle String? @map("content_title")
  contentHtml  String? @map("content_html")
  imageUrl     String? @map("image_url")

  isActive       Boolean @default(true) @map("is_active")
  // Surfaced as "جستجوهای مرتبط" on search pages (Odoo x_suggest).
  isSuggested    Boolean @default(false) @map("is_suggested")
  showInHomepage Boolean @default(false) @map("show_in_homepage")
  showInShomal   Boolean @default(false) @map("show_in_shomal")
  sortOrder      Int     @default(0) @map("sort_order")

  conditions SeoTagCondition[]
  tagPages   TagPage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("seo_tags")
}

// One clause of a tag's filter. Conditions sharing a `groupIndex` are OR-ed
// together; separate groups are AND-ed. This reproduces Odoo's prefix-notation
// domains exactly — e.g. `village` is
//   [type=خانه روستایی, '|', area=روستایی, area=حومه شهر]
// which becomes group 0 = {type: خانه روستایی} AND
//               group 1 = {area: روستایی} OR {area: حومه شهر}.
model SeoTagCondition {
  id         Int    @id @default(autoincrement())
  tagId      Int    @map("tag_id")
  tag        SeoTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  groupIndex Int    @default(0) @map("group_index")

  // Exactly one of these identifies what to match against.
  amenityKey String? @map("amenity_key") // -> Amenity.key
  ruleKey    String? @map("rule_key") // -> Rule.key
  // Categorical value for attributes like نوع اقامتگاه / منطقه اقامتگاه
  // ("خانه ویلایی", "جنگلی"). Null means a plain has-it check — binary
  // amenities never store a "ندارد" link.
  valueName  String? @map("value_name")

  @@index([tagId])
  @@map("seo_tag_conditions")
}

// A tag × location landing page. Legacy Odoo `tag_url` held 9,969 of these,
// 9,967 with hand-written meta that the first migration discarded in favour of
// generated templates. `tagId = null` is the plain location page.
//
// The /tags/… URLs themselves keep 301ing exactly as they do today (see
// LegacyRedirect); this row supplies the curated SEO for the page they land
// on, /search/<slug>?<tag>=1.
model TagPage {
  id         Int       @id @default(autoincrement())
  odooId     Int?      @unique @map("odoo_id")
  // null = a "تگ مادر": the nationwide tag page (/search?pool=1), with no
  // location narrowing it. Odoo kept 166 of these in tag_url with no category.
  locationId Int?      @map("location_id")
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  tagId      Int?      @map("tag_id")
  tag        SeoTag?   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  // The old indexed path, kept for traceability back to the 301 that serves it.
  legacyPath String? @unique @map("legacy_path")

  metaTitle       String? @map("meta_title")
  metaDescription String? @map("meta_description")
  metaKeywords    String? @map("meta_keywords")
  contentTitle    String? @map("content_title")
  contentHtml     String? @map("content_html")

  showInSitemap  Boolean @default(false) @map("show_in_sitemap")
  isActive       Boolean @default(true) @map("is_active")
  // Cached at import from Odoo's `residence_count`; refreshed by the admin.
  residenceCount Int     @default(0) @map("residence_count")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locationId, tagId])
  @@index([tagId])
  @@map("tag_pages")
}

// ---------- Admin ----------

// Saved custom-filter presets for admin list pages (e.g. residences). Shared
// across all admins — anyone can save/apply/delete one. `entity` scopes a
// preset to the list page it applies to; `filters` is a JSON array of
// {field, operator, value}, validated against a per-entity whitelist at the
// API layer (this table has no FK/enum constraints of its own since the
// whitelist can grow without a migration).
model AdminFilterPreset {
  id        Int      @id @default(autoincrement())
  name      String
  entity    String
  filters   Json
  createdAt DateTime @default(now())

  @@index([entity])
  @@map("admin_filter_presets")
}

// ---------- Sitemap & robots.txt ----------
// Rule-driven, not page-by-page: the ops team configures WHICH families of
// URLs belong in the sitemap and under what thresholds, and the files are
// generated from live data on request. Nothing is stored per URL.

enum ChangeFreq {
  ALWAYS
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  NEVER
}

// Single row (id is pinned to 1) holding the site-wide switches.
model SitemapSettings {
  id      Int    @id @default(1)
  siteUrl String @default("https://lidomatrip.com") @map("site_url")

  // Master switch. When false, robots.txt serves "Disallow: /" for every agent
  // — the staging/pre-launch posture. Deliberately separate from robotsEnabled
  // so turning the site private cannot be done by accident.
  allowIndexing Boolean @default(true) @map("allow_indexing")

  sitemapEnabled Boolean @default(true) @map("sitemap_enabled")
  robotsEnabled  Boolean @default(true) @map("robots_enabled")

  // The sitemap spec caps a file at 50,000 URLs / 50MB. Kept below the ceiling
  // so a long URL set cannot push a file over the byte limit.
  maxUrlsPerFile Int @default(45000) @map("max_urls_per_file")

  // Free-text appended verbatim to robots.txt, for directives this model does
  // not cover (Host:, Clean-param:, vendor-specific lines).
  robotsExtra String? @map("robots_extra")
  crawlDelay  Int?    @map("crawl_delay")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sitemap_settings")
}

// One row per URL family. `key` is matched in code — rows are seeded, not
// created by admins, because each key maps to a query the generator knows.
model SitemapSection {
  id    Int    @id @default(autoincrement())
  key   String @unique // static | locations | tag-pages | residences | hosts
  label String

  isEnabled  Boolean    @default(true) @map("is_enabled")
  changeFreq ChangeFreq @default(WEEKLY) @map("change_freq")
  priority   Float      @default(0.5)

  // Thin-content guard: a place or tag page with almost no listings is a weak
  // page to hand a crawler. 0 disables the check.
  minResidenceCount Int @default(0) @map("min_residence_count")

  // Include <lastmod>. Off for families whose updatedAt is noisy.
  includeLastmod Boolean @default(true) @map("include_lastmod")

  // tag-pages only: honour Odoo x_show_in_sitemap. Odoo flagged just 58 of
  // 9,312 pages, so leaving this on keeps the sitemap hostage to a legacy
  // flag. Turn it off to include every active tag page above the threshold.
  requireSitemapFlag Boolean @default(true) @map("require_sitemap_flag")

  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sitemap_sections")
}

// Extra robots.txt directives, editable in the admin panel.
model RobotsRule {
  id        Int     @id @default(autoincrement())
  userAgent String  @default("*") @map("user_agent")
  // "Disallow" | "Allow"
  directive String  @default("Disallow")
  path      String
  isActive  Boolean @default(true) @map("is_active")
  note      String?
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userAgent])
  @@map("robots_rules")
}
