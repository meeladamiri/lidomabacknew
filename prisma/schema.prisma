  label     String
  href      String
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("home_search_suggestions")
}

// ---------------------------------------------------------------------------
// Home page sliders ("رِیل"‌ها)
//
// The home page's listing rails used to be hardcoded in home.service.ts — the
// admin panel could rename a section but not choose which listings it showed
// or add a new one. These two tables move that decision into the panel.
//
// A RESIDENCE rail names a source (a city slug, a curated SEO tag, a residence
// type, or a flag) and the backend fills it with published listings ordered by
// `Residence.importance` — the priority the listings team already maintains —
// so the rail follows the same ordering rule as everything else.
//
// A DESTINATION rail carries its own tiles instead: a city or tag with its own
// image and link, edited by hand.
// ---------------------------------------------------------------------------

enum HomeRailKind {
  RESIDENCE
  DESTINATION
}

enum HomeRailSource {
  CITY // sourceSlug is a location slug; expands through location_includes
  TAG // sourceSlug is a SeoTag.key
  TYPE // sourceSlug is a ResidenceType value (VILLA / SUIT / BOOMGARDI / HOTEL)
  FAST // instant-booking listings
  OFFER // discounted listings
  TOP_RATED // highest rated with at least one review
  ALL // no filter; importance order only
}

model HomeRail {
  id           Int          @id @default(autoincrement())
  kind         HomeRailKind @default(RESIDENCE)
  title        String?
  subtitle     String?
  // The page has exactly one H1 (the hero), so a rail heading is H2 or deeper.
  headingLevel Int          @default(2) @map("heading_level")

  // RESIDENCE rails only.
  sourceType HomeRailSource? @map("source_type")
  sourceSlug String?         @map("source_slug")
  take       Int             @default(15)

  // "مشاهده همه" target. Derived from the source when left empty.
  linkTo String? @map("link_to")

  isEnabled Boolean @default(true) @map("is_enabled")
  sortOrder Int     @default(0) @map("sort_order")

  items HomeRailItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("home_rails")
}

// Tiles of a DESTINATION rail.
model HomeRailItem {
  id       Int      @id @default(autoincrement())
  railId   Int      @map("rail_id")
  rail     HomeRail @relation(fields: [railId], references: [id], onDelete: Cascade)
  title    String
  subtitle String?
  imageUrl String?  @map("image_url")
  alt      String?
  link     String?

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([railId])
  @@map("home_rail_items")
}

// ---------- Conversations ----------

model Conversation {
  id       Int                @id @default(autoincrement())
  // URLs carry this, not the primary key: a sequential id in a chat URL is an
  // invitation to walk other people's threads.
  publicId String             @unique @map("public_id")
  type     ConversationType
  status   ConversationStatus @default(OPEN)

  // Support only — what the user said it was about.
  subject String?

  // One thread per reservation, enforced here rather than by read-then-write
  // in the service, which loses under concurrency.
  bookingId Int?         @unique @map("booking_id")
  booking   Reservation? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  // Denormalised from the booking so the admin list can filter by residence
  // and the thread header can name it without a join through reservations.
  residenceId Int?       @map("residence_id")
  residence   Residence? @relation(fields: [residenceId], references: [id], onDelete: SetNull)

  // Support: whoever answered first owns it.
  assignedAdminId Int?  @map("assigned_admin_id")
  assignedAdmin   User? @relation("AssignedConversations", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  // Denormalised so the conversation list is one query instead of one per row.
  lastMessageAt      DateTime? @map("last_message_at")
  lastMessagePreview String?   @map("last_message_preview")

  participants ConversationParticipant[]
  messages     Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status, lastMessageAt])
  @@index([residenceId])
  @@map("conversations")
}

model ConversationParticipant {
  id             Int          @id @default(autoincrement())
  conversationId Int          @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         Int          @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  role ParticipantRole

  // Counted here rather than derived. The header badge runs on every page
  // load, and a COUNT over messages joined to read state is exactly the shape
  // of query that made the home page take two seconds.
  unreadCount       Int       @default(0) @map("unread_count")
  lastReadAt        DateTime? @map("last_read_at")
  lastReadMessageId Int?      @map("last_read_message_id")

  // Last SMS about this thread, for the notification throttle's slow path.
  notifiedAt DateTime? @map("notified_at")
  isMuted    Boolean   @default(false) @map("is_muted")
  leftAt     DateTime? @map("left_at")

  createdAt DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int          @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Null for SYSTEM messages, and for a sender whose account was deleted.
  senderId   Int?             @map("sender_id")
  sender     User?            @relation("SentMessages", fields: [senderId], references: [id], onDelete: SetNull)
  senderRole ParticipantRole? @map("sender_role")

  type MessageType @default(TEXT)
  body String

  // SYSTEM payload: { kind, reference, startDate, endDate, guestsCount, ... }
  // so the front can render a status card instead of parsing a sentence.
  meta Json?

  attachmentUrl  String? @map("attachment_url")
  attachmentName String? @map("attachment_name")
  attachmentSize Int?    @map("attachment_size")

  // Optimistic send needs a retry to be a no-op, not a duplicate. Unique per
  // conversation, so the database settles it rather than the UI.
  clientNonce String? @map("client_nonce")

  // Off-platform contact detected in the body (phone number, messenger id).
  // Flagged for the panel, never blocked.
  flagged Boolean @default(false)

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now())

  @@unique([conversationId, clientNonce])
  @@index([conversationId, id])
  @@map("messages")
}

// ---------- Host submission wizard content ----------

// The tiles a host picks from in the wizard's first steps. These were three
// hardcoded arrays in the front's bundle, with one shared placeholder image
// for every option — so nobody could change a label, add a region, or give
// the tiles real photographs without a deploy.
enum WizardOptionKind {
  RES_TYPE // step 1 — the kind of place
  REGION // step 2 — which part of the country
  RENT_TYPE // step 3 — whole place or per room
}

model WizardStep {
  id Int @id @default(autoincrement())

  // 0..14, matching the ?step= parameter the wizard runs on.
  step Int @unique

  title       String
  // Shown under the title. The old wizard had nowhere to explain a step.
  description String?
  // The help panel behind the "?" button.
  helpText    String? @map("help_text")
  iconUrl     String? @map("icon_url")

  isEnabled Boolean @default(true) @map("is_enabled")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wizard_steps")
}

model WizardOption {
  id   Int              @id @default(autoincrement())
  kind WizardOptionKind

  // The value written onto the residence. Renaming an option here renames it
  // for new drafts only — existing residences keep the string they were saved
  // with, which is why this is not a foreign key.
  name        String
  description String?
  imageUrl    String? @map("image_url")

  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, sortOrder])
  @@map("wizard_options")
}

// ---------------------------------------------------------------- notifications

enum NotificationKind {
  // Guest side
  BOOKING_REQUESTED
  BOOKING_APPROVED
  BOOKING_REJECTED
  BOOKING_CANCELLED
  BOOKING_EXPIRED
  BOOKING_COMPLETED
  // Host side
  BOOKING_NEW_REQUEST
  REVIEW_RECEIVED
  RESIDENCE_PUBLISHED
  RESIDENCE_REJECTED
  // Either
  MESSAGE_RECEIVED
  ACCOUNT_VERIFIED
}

// One line in a user's notification list.
//
// The title and body are rendered at write time rather than looked up from a
// template at read time. A booking's price and dates can change after the
// notification fires, and "your booking was approved" must keep saying what it
// said when it was sent — a notification is a record of an event, not a live
// view of the thing it happened to.
//
// linkUrl is where tapping it goes. Storing the destination rather than
// deriving it from kind + entityId keeps the front from having to know every
// routing rule, and lets one kind point at different places for host and guest.
model Notification {
  id     Int  @id @default(autoincrement())
  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind  NotificationKind
  title String
  body  String

  linkUrl String? @map("link_url")

  // What it is about. Loose on purpose — these point at several tables, and a
  // real foreign key per kind would mean a column per kind.
  entityType String? @map("entity_type")
  entityId   Int?    @map("entity_id")

  readAt     DateTime? @map("read_at")
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  // One notification per event per user. The same reservation moving to
  // APPROVED twice (a retry, a double-click in the panel) must not produce two
  // lines. Enforced by the database rather than by a check-then-insert, which
  // two concurrent requests would both pass.
  @@unique([userId, kind, entityType, entityId])
  // The list query: a user's rows, newest first, filtered by archived state.
  @@index([userId, archivedAt, id])
  @@map("notifications")
}

// ---------------------------------------------------------------------- wallet

enum WalletTransactionKind {
  BOOKING_INCOME // a host's share of a completed stay
  BOOKING_REFUND // money returned to a guest
  SETTLEMENT // paid out to a bank account
  GIFT // promotional credit
  ADJUSTMENT // a correction made by an admin
}

enum WalletTransactionStatus {
  PENDING
  DONE
  FAILED
}

enum SettlementStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
}

// A user's money, split three ways because the UI and the rules differ.
//
// balance        withdrawable now
// blockedBalance earned but held until the stay ends and the refund window closes
// giftBalance    promotional credit; spendable, never withdrawable
//
// The balances are stored rather than summed from transactions on every read.
// They are only ever written inside the same database transaction that writes
// the ledger row, so the two cannot drift; and this is read on every wallet
// page load, where summing a host's whole history would get slower every month.
model Wallet {
  id     Int  @id @default(autoincrement())
  userId Int  @unique @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  balance        Float @default(0)
  blockedBalance Float @default(0) @map("blocked_balance")
  giftBalance    Float @default(0) @map("gift_balance")

  transactions WalletTransaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("wallets")
}

// The ledger. Append-only: a correction is another row, never an edit.
model WalletTransaction {
  id       Int    @id @default(autoincrement())
  walletId Int    @map("wallet_id")
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  kind   WalletTransactionKind
  status WalletTransactionStatus @default(DONE)

  // Signed: positive is money in, negative is money out. One column rather
  // than a debit/credit pair keeps the running total a plain sum.
  amount Float

  // The balance this row produced, so a statement can be rendered without
  // replaying every earlier row.
  balanceAfter Float @map("balance_after")

  description   String
  failureReason String? @map("failure_reason")

  reservationId Int?         @map("reservation_id")
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([walletId, id])
  @@map("wallet_transactions")
}

// A request to move money out to a bank account.
model SettlementRequest {
  id     Int  @id @default(autoincrement())
  userId Int  @map("user_id")
  user   User @relation("SettlementRequests", fields: [userId], references: [id], onDelete: Cascade)

  amount Float
  status SettlementStatus @default(REQUESTED)

  // Copied at request time, not read from the bank account later. A host who
  // edits their card after asking for a payout must not silently redirect a
  // payment that is already being processed, and the record has to show where
  // the money was actually sent.
  cardNumber  String? @map("card_number")
  shabaNumber String? @map("shaba_number")
  ownerName   String? @map("owner_name")

  adminNote     String? @map("admin_note")
  processedById Int?    @map("processed_by_id")
  processedBy   User?   @relation("ProcessedSettlements", fields: [processedById], references: [id], onDelete: SetNull)

  processedAt DateTime? @map("processed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, id])
  @@index([userId, id])
  @@map("settlement_requests")
}

/// Site-wide reservation money rules. A single row (id = 1).
///
/// Odoo kept these as per-partner and per-product columns with no global
/// default, so "what do we charge" was only answerable by counting: 276,385
/// hosts on 15%, a few hundred on something else. The rate lives here now and
/// a host's own rate is the exception, not the only place the number exists.
model ReservationSettings {
  id Int @id @default(1)

  /// کارمزد میزبان وبسایت (درصد) — the site's cut of the rent, taken from the
  /// host. Overridable per host on User.commissionPercent.
  commissionPercent Float @default(15) @map("commission_percent")

  /// ارزش افزوده (درصد) — VAT, charged on the commission rather than on the
  /// rent. This is how Odoo computed it: 67,500 of VAT on a 675,000 cut of a
  /// 4,500,000 booking. Applying it to the rent instead would be ten times
  /// too much, so the base matters more than the rate.
  vatPercent Float @default(10) @map("vat_percent")

  /// کارمزد مهمان وبسایت (درصد) — a service fee added on top of the rent for
  /// the guest. Odoo charged ~5% on some bookings; zero here until it is
  /// deliberately turned on.
  guestCommissionPercent Float @default(0) @map("guest_commission_percent")

  /// A host's income is held until the stay starts rather than until it ends:
  /// the guest has arrived, so the booking is no longer going to fall through.
  releaseOnStartDate Boolean @default(true) @map("release_on_start_date")

  /// مدت زمان تایید میزبان — minutes a host has to accept before the booking
  /// expires and the dates go back on sale.
  ///
  /// Odoo kept one field for both this and the payment window ("مهلت تایید یا
  /// پرداخت"), so it could not set them apart. Its stored deadlines cluster at
  /// 120 minutes (85k bookings), 60 (47k) and 720 (26k). Two fields here
  /// because the two waits are not the same wait: a host is being asked to
  /// make a decision, a guest is being asked to finish paying.
  approvalWindowMinutes Int @default(120) @map("approval_window_minutes")

  /// مدت زمان پرداخت مهمان — minutes to complete payment after the host accepts.
  paymentWindowMinutes Int @default(120) @map("payment_window_minutes")

  /// The cancellation ladder, from the site's own published policy
  /// (`/reserve-cancellation-policy`). Settings rather than constants because
  /// this is the page guests are held to, and the two must be able to move
  /// together.
  ///
  ///   ≥72h before check-in   کسر ۲۰٪ از مبلغ کل
  ///   <72h before check-in   شب اول + ۲۰٪ مابقی شب‌ها
  ///   on or after check-in   دو شب اول + شب‌های سپری شده + ۲۰٪ مابقی
  cancelPenaltyPercent Float @default(20) @map("cancel_penalty_percent")

  /// Hours before check-in at which the ladder steps up.
  cancelEarlyHours Int @default(72) @map("cancel_early_hours")

  /// Nights charged in full when cancelling inside the window, and on/after
  /// the start date. Stated as counts because that is how the policy states
  /// them: "شب اول" and "دو شب اول".
  cancelNightsLate    Int @default(1) @map("cancel_nights_late")
  cancelNightsStarted Int @default(2) @map("cancel_nights_started")

  /// Smallest payout a host may ask for.
  minSettlement Int @default(50000) @map("min_settlement")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("reservation_settings")
}

/// Money actually sent to a host — Odoo's `x_clearing`, with its transaction
/// reference, date and sending account.
///
/// Separate from SettlementRequest, which is the host asking. This is the
/// site paying, and it can happen without any request: the common case is an
/// admin settling a specific reservation before the guest even arrives.
model HostDeposit {
  id     Int  @id @default(autoincrement())
  hostId Int  @map("host_id")
  host   User @relation("HostDeposits", fields: [hostId], references: [id], onDelete: Cascade)

  /// The booking this pays for. Null for a lump payment against the balance.
  reservationId Int?         @map("reservation_id")
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  /// What this row is. Odoo's deposit panel offered exactly three settlement
  /// methods plus an override, and they are not interchangeable:
  ///
  ///   REMAINDER  مانده واریز      — paying off what is left
  ///   DEPOSIT    واریز بیعانه     — paying part of it up front
  ///   HOST_DEBIT کسر بدهی میزبان  — cancelling what the host owes us against
  ///                                 what we owe them; no money leaves the bank
  ///   ADJUSTMENT ویرایش مانده واریز — a correction to the remaining figure,
  ///                                 not a payment at all
  kind HostDepositKind @default(REMAINDER)

  amount      Float
  depositedAt DateTime @default(now()) @map("deposited_at")

  /// shaba | card — how it was sent. Null for the kinds that move no money.
  payWith String? @map("pay_with")

  /// The staff member who recorded it, by name, kept as text: the row must
  /// still say who did this after the account is renamed or deactivated.
  payerName String? @map("payer_name")

  /// شماره تراکنش / حساب فرستنده — what makes this auditable against a bank
  /// statement. Without them a deposit row is just an assertion.
  txnId       String? @map("txn_id")
  sender      String?
  description String?

  createdById Int? @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([hostId, id])
  @@index([reservationId])
  @@map("host_deposits")
}

enum HostDepositKind {
  REMAINDER // مانده واریز
  DEPOSIT // واریز بیعانه
  HOST_DEBIT // کسر بدهی میزبان
  ADJUSTMENT // ویرایش مانده واریز — a correction, not a payment
}

/// نحوه ارسال پیام لغو — who hears about a cancellation.
///
/// A real choice rather than a policy, because the reason for cancelling
/// changes who needs to know. A site cancellation coordinated with the host by
/// phone does not need a message telling that host it happened.
enum CancelNotifyMode {
  BOTH // هر دو
  ONLY_GUEST // فقط مهمان
  ONLY_HOST // فقط میزبان
  NONE // هیچ‌کدام
}

/// Every move a booking makes between states, and why.
///
/// A reservation's state is one column, so it only ever says where a booking
/// is now. The question support actually asks is how it got there — who moved
/// it, when, and what they were told. That answer used to exist only in
/// somebody's memory.
///
/// Written for automatic transitions too, not just hand-made ones. A timeline
/// that shows only what people did, with the system's own moves missing, reads
/// as though nothing happened in between.
model ReservationStateChange {
  id            Int         @id @default(autoincrement())
  reservationId Int         @map("reservation_id")
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  fromState ReservationState? @map("from_state")
  toState   ReservationState  @map("to_state")

  /// Required for a manual change. The whole point of the audit line is the
  /// sentence a person had to write before the state would move.
  note String?

  /// Who moved it. The name is copied, not joined: the row must still say who
  /// did this after the account is renamed or deleted.
  changedById   Int?    @map("changed_by_id")
  changedByName String? @map("changed_by_name")

  /// MANUAL for a person, and the job or flow name for everything else.
  source String @default("MANUAL")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([reservationId, id])
  @@map("reservation_state_changes")
}

/// What kind of thing happened.
///
/// One table rather than one per kind, because the screen that reads it is a
/// single timeline: a call, a status change and a sent voucher are the same
/// question ("what happened to this booking") asked once.
enum ActivityKind {
  CALL // تماس — logged by hand
  NOTE // یادداشت — logged by hand
  STATE_CHANGE // وضعیت رزرو عوض شد
  FIELD_CHANGE // تاریخ، قیمت یا چیز دیگری عوض شد
  MESSAGE_SENT // پیامی برای مهمان یا میزبان رفت
}

enum CallDirection {
  INBOUND // تماس ورودی
  OUTBOUND // تماس خروجی
}

enum CallParty {
  GUEST
  HOST
  OTHER
}

/// The activity and communication log.
///
/// Immutable: rows are written and never changed. That is enforced by a
/// database rule in the migration, not by the absence of an update endpoint —
/// "nothing calls update" is a property of today's code, and this needs to be
/// a property of the data.
///
/// Everything is optional except `kind` and `summary`, because the log has to
/// accept a call about a guest with no booking as readily as a price change on
/// one. `summary` is rendered when the row is written and stored: a log that
/// re-renders itself from ids will quietly change what it said once the
/// booking it points at moves on.
model ActivityLog {
  id   Int          @id @default(autoincrement())
  kind ActivityKind

  /// What it is about. A call can be about a person and no booking.
  reservationId Int?         @map("reservation_id")
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  userId        Int?         @map("user_id")
  user          User?        @relation("ActivityAbout", fields: [userId], references: [id], onDelete: SetNull)
  residenceId   Int?         @map("residence_id")

  /// CALL only.
  callDirection CallDirection? @map("call_direction")
  callParty     CallParty?     @map("call_party")
  /// Answered, no answer, wrong number — free text, because the list of ways a
  /// phone call can go is longer than any enum anyone will maintain.
  callOutcome   String?        @map("call_outcome")

  /// One line, already readable, always present.
  summary String
  /// Before/after for FIELD_CHANGE, and anything else structured a kind needs.
  details Json?

  /// Who did it. Name copied, not joined — see HostDeposit for why.
  actorId   Int?    @map("actor_id")
  actorName String? @map("actor_name")

  /// MANUAL for a person; the flow or job name for anything automatic.
  source String @default("MANUAL")

  createdAt DateTime @default(now()) @map("created_at")

  // The timeline reads by booking, newest first. The other three cover the
  // filters the panel offers: by person, by kind over a date range, by admin.
  @@index([reservationId, id])
  @@index([userId, id])
  @@index([kind, createdAt])
  @@index([actorId, createdAt])
  @@map("activity_logs")
}
