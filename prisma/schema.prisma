// LidomaTrip backend — Phase 1 schema
// Scope: auth, users, residences/rooms, amenities/rules, calendar & pricing,
// search support, reservations, favourites, host bank info, admin.
// Phase 2 (not modeled yet): wallet transactions, host payouts/settlements,
// order-scoped chat, reviews, complaints/contact-form, support chat, vouchers.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum UserRole {
  USER
  ADMIN
}

enum VerificationStatus {
  NOT_CONFIRMED
  CHECKING
  CONFIRMED
}

// "نوع ملک" — the residence's own category, independent of the city
// taxonomy. Mirrors legacy Odoo product_template.x_display_type
// (suit | boomgardi | hotel); Odoo's rare "both" collapses to SUIT, which
// is how the old site's tag domains already treated it.
enum ResidenceType {
  BOOMGARDI // eco-lodge / rural stay
  SUIT // villa / apartment / suite
  HOTEL // hotel & hotel-apartment
}

enum ResidenceState {
  DRAFT // wizard in progress, not submitted
  PENDING // submitted, awaiting review
  PUBLISHED
  REJECTED
  DEACTIVATED
  DELETED
}

enum BedRoomType {
  NONE
  SHARED
  DEDICATED
}

enum DiscountType {
  PERCENTAGE
  FIXED_PRICE
}

enum AmenityFieldType {
  TEXT
  DROPDOWN
  SWITCH
  CHECKBOX
}

enum ReservationState {
  HOST_APPROVAL
  SECOND_PAYMENT
  DONE
  CANCEL
  EXPIRED
}

enum ReservationCancelledBy {
  HOST_CANCELLED
  LIDOMA_CANCELLED
  GUEST_CANCELLED
}

enum OtpPurpose {
  LOGIN
  SIGNUP
  RESET_PASSWORD
}

// ---------- Geo ----------

model Province {
  id        Int      @id @default(autoincrement())
  name      String
  titleEn   String?  @map("title_en")
  // SEO fields for the /search/<titleEn> province page — same sources as City.
  metaTitle       String? @map("meta_title")
  metaDescription String? @map("meta_description")
  contentTitle    String? @map("content_title")
  contentHtml     String? @map("content_html")
  latitude  Float?
  longitude Float?
  cities    City[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("provinces")
}

// Legacy Odoo SEO URLs (e.g. "/tags/villa/اجاره-ویلا-در-آبادان") -> their
// 301 target on the new site (e.g. "/search/abadan?villa=1"). Populated from
// the legacy `tag_url` table by scripts/migrate-odoo-tag-urls.ts; consumed by
// the frontend's /tags/[...slug] catch-all page so old indexed URLs keep
// their SEO value.
model LegacyRedirect {
  id     Int    @id @default(autoincrement())
  path   String @unique
  target String

  @@map("legacy_redirects")
}

// Legacy Odoo image URLs ("/web/image/<model>/<odoo id>/image/<seo-name>.jpg",
// served from cdn.lidomatrip.com) -> the migrated object-storage URL. These
// are Google-Images-indexed; the frontend's /web/image catch-all 301s them.
// Populated by scripts/migrate-odoo-image-urls.ts.
model LegacyImageRedirect {
  id     Int    @id @default(autoincrement())
  model  String // "product.image" (gallery) | "product.template" (main image)
  odooId Int    @map("odoo_id")
  url    String

  @@unique([model, odooId])
  @@map("legacy_image_redirects")
}

model City {
  id         Int         @id @default(autoincrement())
  name       String
  titleEn    String?     @map("title_en")
  imageUrl   String?     @map("image_url")
  // SEO fields for the /search/<titleEn> city page, migrated from Odoo's
  // product_public_category (website_meta_*, content, x_content_title).
  metaTitle       String? @map("meta_title")
  metaDescription String? @map("meta_description")
  contentTitle    String? @map("content_title")
  contentHtml     String? @map("content_html")
  latitude   Float?
  longitude  Float?
  provinceId Int?        @map("province_id")
  province   Province?   @relation(fields: [provinceId], references: [id])
  residences Residence[]
  users      User[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([provinceId])
  @@map("cities")
}

// ---------- Users ----------

// Admin-issued warning ("کارت زرد") with a required reason — shown on the
// admin user-detail page.
model UserYellowCard {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation("UserYellowCards", fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  adminId   Int?     @map("admin_id")
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("user_yellow_cards")
}

model User {
  id                 Int                 @id @default(autoincrement())
  phone              String              @unique
  passwordHash       String?             @map("password_hash")
  name               String?
  email              String?
  nationalCode       String?             @map("national_code")
  address            String?
  cityId             Int?                @map("city_id")
  city               City?               @relation(fields: [cityId], references: [id])
  zip                String?
  fax                String?
  job                String?
  education          String?
  birthDay           Int?                @map("birth_day")
  birthMonth         Int?                @map("birth_month")
  birthYear          Int?                @map("birth_year")
  emergencyPhone     String?             @map("emergency_phone")
  contactPhone       String?             @map("contact_phone")
  avatarUrl          String?             @map("avatar_url")
  nationalCardUrl    String?             @map("national_card_url")
  description        String?
  verificationStatus VerificationStatus  @default(NOT_CONFIRMED) @map("verification_status")
  isHost             Boolean             @default(false) @map("is_host")
  role               UserRole            @default(USER)
  // admin panel: deactivated users can't log in / operate
  isActive           Boolean             @default(true) @map("is_active")
  // admin panel: "میزبان ویژه" highlight flag
  isSpecialHost      Boolean             @default(false) @map("is_special_host")

  bankAccount   BankAccount?
  yellowCards   UserYellowCard[] @relation("UserYellowCards")
  residences    Residence[]     @relation("HostResidences")
  reservationsAsGuest Reservation[] @relation("GuestReservations")
  reservationsAsHost  Reservation[] @relation("HostReservations")
  favourites    Favourite[]
  otpCodes      OtpCode[]
  refreshTokens RefreshToken[]
  reviews       Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cityId])
  @@map("users")
}

model BankAccount {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardNumber     String?  @map("card_number")
  cardOwnerName  String?  @map("card_owner_name")
  shabaNumber    String?  @map("shaba_number")
  shabaOwnerName String?  @map("shaba_owner_name")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("bank_accounts")
}

model OtpCode {
  id         Int        @id @default(autoincrement())
  phone      String
  userId     Int?       @map("user_id")
  user       User?      @relation(fields: [userId], references: [id])
  codeHash   String     @map("code_hash")
  purpose    OtpPurpose
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at")
  consumedAt DateTime?  @map("consumed_at")
  createdAt  DateTime   @default(now())

  @@index([phone, purpose])
  @@map("otp_codes")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------- Amenities & Rules (catalogs) ----------

model Amenity {
  id         Int               @id @default(autoincrement())
  // stable English key from Odoo's product_attribute.x_title_en (pool,
  // jacuzzi, parking, type, area, ...) — search tag filters match on this
  key        String?           @unique
  category   String?
  name       String
  iconUrl    String?           @map("icon_url")
  features   AmenityFeature[]
  residences ResidenceAmenity[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@map("amenities")
}

model AmenityFeature {
  id          Int              @id @default(autoincrement())
  amenityId   Int              @map("amenity_id")
  amenity     Amenity          @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  fieldType   AmenityFieldType @map("field_type")
  name        String
  placeholder String?
  values      String? // comma-separated option list, e.g. "دارد, ندارد"
  inFilter    Boolean          @default(false) @map("in_filter")

  @@index([amenityId])
  @@map("amenity_features")
}

model Rule {
  id         Int            @id @default(autoincrement())
  // stable English key from Odoo's product_attribute.x_title_en
  // (smoking, pets, events, 24h, singles, id-required, cancellation)
  key        String?        @unique
  category   String?
  name       String
  iconUrl    String?        @map("icon_url")
  residences ResidenceRule[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@map("rules")
}

// ---------- Residences ----------

model Residence {
  id          Int            @id @default(autoincrement())
  reference   String         @unique
  hostId      Int            @map("host_id")
  host        User           @relation("HostResidences", fields: [hostId], references: [id])
  type        ResidenceType
  state       ResidenceState @default(DRAFT)
  step        Int?
  completionPercent Int?     @map("completion_percent")
  published   Boolean        @default(false)

  name        String
  name2       String?
  description String?
  region      String? // coarse marketing region picked in the wizard (e.g. "شمال", "تهران و اطراف")
  rentType    String? @map("rent_type") // whole-place vs per-room etc, wizard step 3

  cityId       Int?    @map("city_id")
  city         City?   @relation(fields: [cityId], references: [id])
  neighborhood String?
  address      String?
  latitude     Float?
  longitude    Float?
  floor        String?
  foundationArea Float? @map("foundation_area")
  totalArea      Float? @map("total_area")

  capacity    Int?
  maxCapacity Int?    @map("max_capacity")

  checkinFrom  String? @map("checkin_from")
  checkinTo    String? @map("checkin_to")
  checkout     String?
  minReservableDays Int? @map("min_reservable_days")
  rulesDesc         String? @map("rules_desc") // free-text "additional rules", wizard step 12

  cancelCommission  Float?  @map("cancel_commission")
  reserveCommission Float?  @map("reserve_commission")
  cancellationPolicy     String? @map("cancellation_policy") // preset key or "custom", wizard step 13
  cancellationPolicyDesc String? @map("cancellation_policy_desc")
  fullReturnTime          Int?    @map("full_return_time")
  beforeStartTime         Int?    @map("before_start_time")
  hostShareTotalAmount    Float?  @map("host_share_total_amount")
  hostSharePastNights     Float?  @map("host_share_past_nights")
  hostShareFutureNights   Float?  @map("host_share_future_nights")

  otherAmenities String? @map("other_amenities") // free-text "other" amenities, wizard step 6

  hostNationalCardUrl  String? @map("host_national_card_url")
  documentUrl          String? @map("document_url") // property ownership proof
  ownerNationalCardUrl String? @map("owner_national_card_url") // only when host isn't the owner

  // General pricing (per-residence baseline; rooms may override)
  weekPrice          Float?  @map("week_price")
  weekendPrice       Float?  @map("weekend_price")
  peakPrice          Float?  @map("peak_price")
  extraPrice         Float?  @map("extra_price")
  extraGuestsPrice    Float? @map("extra_guests_price")
  weeklyDiscount     Float?  @map("weekly_discount")
  monthlyDiscount    Float?  @map("monthly_discount")

  videoUrl    String? @map("video_url")
  // Host's free-text rules (legacy Odoo product_template.x_extra_rules) —
  // {"desc": "...", "<rule attr id>": ""|{"desc": "..."}}; the frontend's
  // ResRules reads its stringified form.
  extraRules  Json?   @map("extra_rules")
  // Boomgardi-only free-text feature names (legacy x_features, "#%"-joined)
  // — shown as "امکانات بوم گردی" on the detail page.
  boomgardiFeatures Json? @map("boomgardi_features")
  isFast      Boolean @default(false) @map("is_fast") // instant-book default
  isFull      Boolean @default(false) @map("is_full")
  isOffer     Boolean @default(false) @map("is_offer")
  salesCount  Int     @default(0) @map("sales_count")

  averageRating Float @default(0) @map("average_rating")
  reviewsCount  Int   @default(0) @map("reviews_count")

  // "اهمیت اقامتگاه" — manual ranking weight set by the ops team (legacy
  // Odoo product_template.x_sequence, values up to 2e9). Higher = shown
  // earlier in the default ("پیشنهاد لیدوما") search ordering.
  importance Int @default(0)

  images       ResidenceImage[]
  rooms        Room[]
  amenities    ResidenceAmenity[]
  rules        ResidenceRule[]
  calendarDays CalendarDay[]
  reservations Reservation[]
  favouritedBy Favourite[]
  reviews      Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostId])
  @@index([cityId])
  @@index([state, published])
  @@map("residences")
}

model ResidenceImage {
  id          Int       @id @default(autoincrement())
  residenceId Int       @map("residence_id")
  residence   Residence @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  url         String
  title       String?
  sortOrder   Int       @default(0) @map("sort_order")
  isMain      Boolean   @default(false) @map("is_main")
  createdAt   DateTime  @default(now())

  @@index([residenceId])
  @@map("residence_images")
}

model Room {
  id          Int       @id @default(autoincrement())
  residenceId Int       @map("residence_id")
  residence   Residence @relation(fields: [residenceId], references: [id], onDelete: Cascade)

  name        String
  description String?
  image       String?

  capacity    Int?
  maxCapacity Int?  @map("max_capacity")
  singleBed   Int   @default(0) @map("single_bed")
  doubleBed   Int   @default(0) @map("double_bed")
  traditionalBed Int @default(0) @map("traditional_bed")
  extraBeds   Int   @default(0) @map("extra_beds")

  weekPrice        Float? @map("week_price")
  weekendPrice     Float? @map("weekend_price")
  peakPrice        Float? @map("peak_price")
  extraPrice       Float? @map("extra_price")
  extraPeakPrice   Float? @map("extra_peak_price")
  weeklyDiscount   Float? @map("weekly_discount")
  monthlyDiscount  Float? @map("monthly_discount")

  coolingSystem    Boolean?    @map("cooling_system")
  heatingSystem    Boolean?    @map("heating_system")
  refrigerator     BedRoomType?
  wc               BedRoomType?
  separateBathroom Boolean?    @map("separate_bathroom")
  freeBreakfast    Boolean?    @map("free_breakfast")

  isFast     Boolean @default(false) @map("is_fast")
  salesCount Int     @default(0) @map("sales_count")

  calendarDays      CalendarDay[]
  reservationRooms  ReservationRoom[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([residenceId])
  @@map("rooms")
}

model ResidenceAmenity {
  id            Int       @id @default(autoincrement())
  residenceId   Int       @map("residence_id")
  residence     Residence @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  amenityId     Int       @map("amenity_id")
  amenity       Amenity   @relation(fields: [amenityId], references: [id])
  extraFeatures Json?     @map("extra_features") // selected feature values keyed by feature name

  @@unique([residenceId, amenityId])
  @@index([amenityId])
  @@map("residence_amenities")
}

model ResidenceRule {
  id          Int       @id @default(autoincrement())
  residenceId Int       @map("residence_id")
  residence   Residence @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  ruleId      Int       @map("rule_id")
  rule        Rule      @relation(fields: [ruleId], references: [id])
  value       Json? // override / description text for this residence

  @@unique([residenceId, ruleId])
  @@index([ruleId])
  @@map("residence_rules")
}

// ---------- Calendar & pricing overrides ----------

model CalendarDay {
  id            Int           @id @default(autoincrement())
  residenceId   Int           @map("residence_id")
  residence     Residence     @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  roomId        Int?          @map("room_id") // null = applies at residence level
  room          Room?         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  date          DateTime      @db.Date
  isBlocked     Boolean       @default(false) @map("is_blocked") // reserved / manually filled
  isFast        Boolean?      @map("is_fast") // instant-book override for this date
  isPeak        Boolean       @default(false) @map("is_peak")
  specialPrice  Float?        @map("special_price")
  discountAmount Float?       @map("discount_amount")
  discountType  DiscountType? @map("discount_type")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NOTE: Postgres does not enforce uniqueness across NULLs, so this
  // constraint does not fully prevent duplicate residence-level
  // (roomId = null) rows under concurrent writes. Fine for single-host
  // sequential updates (the only write path today); if concurrent bulk
  // calendar edits become common, replace with a sentinel roomId or a
  // partial unique index (`WHERE room_id IS NULL`) via a raw migration.
  @@unique([residenceId, roomId, date])
  @@index([residenceId, date])
  @@map("calendar_days")
}

// ---------- Reservations ----------

model Reservation {
  id        Int    @id @default(autoincrement())
  reference String @unique

  residenceId Int       @map("residence_id")
  residence   Residence @relation(fields: [residenceId], references: [id])
  guestId     Int       @map("guest_id")
  guest       User      @relation("GuestReservations", fields: [guestId], references: [id])
  hostId      Int       @map("host_id")
  host        User      @relation("HostReservations", fields: [hostId], references: [id])

  startDate  DateTime @map("start_date") @db.Date
  endDate    DateTime @map("end_date") @db.Date
  expiryDate DateTime? @map("expiry_date") // payment/approval deadline
  daysCount  Int      @map("days_count")

  guestsCount      Int @map("guests_count")
  extraGuestsCount Int @default(0) @map("extra_guests_count")

  state ReservationState @default(HOST_APPROVAL)

  cancelledBy ReservationCancelledBy? @map("cancelled_by")
  cancelReason String?                @map("cancel_reason")
  cancelDesc   String?                @map("cancel_desc")

  totalAmount     Float @map("total_amount")
  paidAmount      Float @default(0) @map("paid_amount")
  remainingAmount Float @default(0) @map("remaining_amount")
  hostShare       Float? @map("host_share")
  websiteShare    Float? @map("website_share")

  voucherCode String? @map("voucher_code")

  guestNameOverride  String? @map("guest_name_override") // booking-for-someone-else
  guestPhoneOverride String? @map("guest_phone_override")

  rooms  ReservationRoom[]
  review Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([residenceId])
  @@index([guestId])
  @@index([hostId])
  @@index([state])
  @@map("reservations")
}

model ReservationRoom {
  id            Int         @id @default(autoincrement())
  reservationId Int         @map("reservation_id")
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  roomId        Int         @map("room_id")
  room          Room        @relation(fields: [roomId], references: [id])

  @@unique([reservationId, roomId])
  @@map("reservation_rooms")
}

// ---------- Reviews ----------
// One review per completed reservation (guest side). The single displayed
// "rating" is an average of 6 sub-scores — matches the shape the frontend's
// review UI (built years before this backend) already expects, so it needs
// no changes: `front/components/SubmitReviewForMyTrip`,
// `front/components/ObserveResidenceDetails/.../ResReviews`,
// `front/components/Host/GuestsReviews`.

model Review {
  id            Int         @id @default(autoincrement())
  reservationId Int         @unique @map("reservation_id")
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  residenceId   Int         @map("residence_id")
  residence     Residence   @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  guestId       Int         @map("guest_id")
  guest         User        @relation(fields: [guestId], references: [id])

  cleaning  Int
  location  Int
  quality   Int
  integrity Int
  greeting  Int
  delivery  Int
  // Stored (not just computed on read) so residence-level average/count
  // aggregation stays a cheap read — recomputed whenever a review is
  // created for that residence.
  averageRating Float @map("average_rating")

  comment    String
  hostAnswer String? @map("host_answer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([residenceId])
  @@index([guestId])
  @@map("reviews")
}

// ---------- Favourites ----------

model Favourite {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  residenceId Int       @map("residence_id")
  residence   Residence @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, residenceId])
  @@map("favourites")
}

// ---------- Admin ----------

// Saved custom-filter presets for admin list pages (e.g. residences). Shared
// across all admins — anyone can save/apply/delete one. `entity` scopes a
// preset to the list page it applies to; `filters` is a JSON array of
// {field, operator, value}, validated against a per-entity whitelist at the
// API layer (this table has no FK/enum constraints of its own since the
// whitelist can grow without a migration).
model AdminFilterPreset {
  id        Int      @id @default(autoincrement())
  name      String
  entity    String
  filters   Json
  createdAt DateTime @default(now())

  @@index([entity])
  @@map("admin_filter_presets")
}
